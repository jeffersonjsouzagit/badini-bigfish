# Badini Big Fish - Environment Variables
# Copie este arquivo para .env e preencha os valores

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# BANCO DE DADOS (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/badini_bigfish?schema=public"

# ============================================
# JWT (Autenticacao)
# ============================================
JWT_SECRET="sua_chave_secreta_aqui_mude_para_producao"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="sua_chave_refresh_secreta_aqui"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================
# CORS (Seguranca)
# ============================================
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# ============================================
# API DE PAGAMENTO (Parceiro)
# ============================================
PAYMENT_API_URL="https://api.parceiro-pagamento.com/v1"
PAYMENT_API_KEY="sua_chave_api_parceiro"
PAYMENT_WEBHOOK_SECRET="secreto_webhook_parceiro"

# ============================================
# EMAIL (Opcional - para confirmacao de pedidos)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-app"

# ============================================
# SEGURANCA
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
